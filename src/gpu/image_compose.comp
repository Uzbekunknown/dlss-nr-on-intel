#version 450
#ifdef NR_DIVIDE_F64
#extension GL_ARB_gpu_shader_fp64 : require   /* the division below, per driver */
#endif
/* SDR composition, preserving the CPU contract's FP32 operation order. The
 * input head and neural history stay on the device. The original alpha and
 * pixels outside the active rectangle are copied without conversion. */
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_GOOGLE_include_directive : require
layout(local_size_x = 256) in;
layout(buffer_reference, scalar, buffer_reference_align = 4) buffer FloatBuf { float v[]; };
layout(buffer_reference, scalar, buffer_reference_align = 4) buffer UintBuf { uint v[]; };
layout(push_constant, scalar) uniform Push {
    uint64_t a, b, c, d, e, f, g, h;
    uint p[16];
} pc;

/* p: frame width,height, left,top, active width,height, valid head width,height,
 * padded head row width, head channels, flags. h: intensity, confidence, gate
 * scale, hold, hold slope, release slope, exposure, contrast, saturation,
 * x ratio,y ratio (FP32), then padding through element 15, byte decode LUT256,
 * then the 65536-entry
 * exact NumPy gate table. Flags: BGRA=1 HISTORY=2 PREVIOUS=4 KEEP=8 GRADE=16 COMPOSED=32,
 * the last the float32 composition into g, which only the change metric reads. MOVED=64
 * (with HISTORY and PREVIOUS): c and d are the network's last output and the game's last
 * frame where they were, and each is read along the client's motion here, as the follower's
 * active-extent pass did (image_history.comp, mode 0) and its two full-resolution images were
 * read back: the motion's address in p[12] and p[13], STALE's float bits in p[11].
 * PREVIOUS_RAW=512 (with PREVIOUS, without MOVED): d is the game's last frame as the bytes it
 * came in, at the frame's extent, decoded here through the same table as this frame's `rgb`,
 * the decode pass's values exactly, where a float32 copy of it was kept for this read.
 *
 * Detail and colour strength away from 1 (`compose_detail`, MLX-DLSS composition.py, which the
 * CPU path runs after this composition): source + colour * lowpass(change) + detail *
 * (change - lowpass(change)), clipped, the change being the composition less the frame, the low
 * pass a separable Gaussian with the frame's edges repeated. Three dispatches, the CPU's float32
 * order in each (NumPy's fallback, which is what runs where OpenCV is not, as in the release):
 *   CHANGE=4096, on this composition: g gets the change, v - rgb, where COMPOSED puts v.
 *   ROWS=1024, one invocation an active pixel: c gets the rows' pass of g's change, each sum
 *     from zero with the next tap's product added, no fused multiply-add. f holds the p[13]
 *     float32 weights, p[14] either side.
 *   COLUMNS=2048: the columns' pass of c, then the sum with colour strength p[11] and detail
 *     strength p[12] (float bits), in the CPU's order; g gets the composition (the change
 *     metric's), e the bytes, the game's alpha kept. */
float unit(float v) { return v < 0.0 ? 0.0 : v > 1.0 ? 1.0 : v; }
uint channel_byte(uint raw, uint c, bool bgra) { return (raw >> ((bgra ? 2u - c : c) * 8u)) & 255u; }
void detail(uint index, uint flags) {
    uint frame_width = pc.p[0];
    uint left = pc.p[2], top = pc.p[3], width = pc.p[4], height = pc.p[5];
    if (index >= width * height) return;
    uint x = index % width, y = index / width;
    bool bgra = (flags & 1u) != 0u;
    FloatBuf weights = FloatBuf(pc.f), change = FloatBuf(pc.g), rows = FloatBuf(pc.c);
    uint taps = pc.p[13], reach = pc.p[14];
    if ((flags & 1024u) != 0u) {
        precise vec3 sum = vec3(0.0);
        for (uint k = 0u; k < taps; ++k) {
            uint at = uint(clamp(int(x + k) - int(reach), 0, int(width) - 1));
            uint from = 3u * (y * width + at);
            float w = weights.v[k];
            for (uint c = 0u; c < 3u; ++c) {
                precise float term = w * change.v[from + c];
                sum[c] = sum[c] + term;
            }
        }
        for (uint c = 0u; c < 3u; ++c) rows.v[3u * index + c] = sum[c];
        return;
    }
    precise vec3 low = vec3(0.0);
    for (uint k = 0u; k < taps; ++k) {
        uint at = uint(clamp(int(y + k) - int(reach), 0, int(height) - 1));
        uint from = 3u * (at * width + x);
        float w = weights.v[k];
        for (uint c = 0u; c < 3u; ++c) {
            precise float term = w * rows.v[from + c];
            low[c] = low[c] + term;
        }
    }
    uint frame_index = (top + y) * frame_width + left + x;
    uint here = UintBuf(pc.a).v[frame_index];
    FloatBuf settings = FloatBuf(pc.h);
    float colour_strength = uintBitsToFloat(pc.p[11]), detail_strength = uintBitsToFloat(pc.p[12]);
    uint packed = here & 0xff000000u;
    for (uint c = 0u; c < 3u; ++c) {
        float source = settings.v[16u + channel_byte(here, c, bgra)];
        precise float moved = change.v[3u * index + c];
        precise float coloured = colour_strength * low[c];
        precise float base = source + coloured;
        precise float high = moved - low[c];
        precise float detailed = detail_strength * high;
        precise float v = unit(base + detailed);
        change.v[3u * index + c] = v;
        float safe = isnan(v) ? 0.0 : unit(v);
        precise float scaled = safe * 255.0;
        precise float rounded = scaled + 0.5;
        packed |= uint(rounded) << ((bgra ? 2u - c : c) * 8u);
    }
    UintBuf(pc.e).v[frame_index] = packed;
}
/* Intel's native FDiv is approximate. One residual correction recovers the
 * correctly-rounded scalar division used by the CPU colour grade. Explicit fma
 * here measures the quotient's residual; the surrounding grade stays precise.
 * NR_DIVIDE_F64 (the `_f64` build, which libxmx's `xmx_image_divide_f64` picks per driver):
 * through double instead. Mesa does not keep the residual's fma exact, and the corrected
 * quotient was a ulp off there in 7-17 % of cases; a double quotient rounded to float is the
 * correctly rounded one, a float quotient never lying on a float's midpoint
 * (HANDOFF 2026-11-22, night). */
float divide(float a, float b) {
#ifdef NR_DIVIDE_F64
    return float(double(a) / double(b));
#else
    precise float q = a / b;
    precise float error = fma(-q, b, a);
    precise float refined = q + error / b;
    return refined;
#endif
}
#include "history_sample.glsl"
/* Rounding to half, spelled as libxmx's constant 1 says for this driver (publish.glsl): Mesa
 * folds `float(float16_t(v))` away and keeps packHalf2x16's round trip, Intel's Windows
 * compiler the other way round. With the cast alone the head went unrounded on Mesa, and the
 * composed bytes moved by one level on about a thousandth of the values. */
layout(constant_id = 1) const bool HALF_BY_CAST = false;
float half_round(float v) {
    return HALF_BY_CAST ? float(float16_t(v)) : unpackHalf2x16(packHalf2x16(vec2(v, 0.0))).x;
}
float trunc_half(float v) {
    uint bits = floatBitsToUint(v);
    float kept = uintBitsToFloat(bits & 0xffffe000u);
    float small = floor(abs(v) * 16777216.0) * (1.0 / 16777216.0);
    small = v < 0.0 ? -small : small;
    return (bits & 0x7fffffffu) >= 0x38800000u ? kept : small;
}
float hue_channel(float p, float q, float t) {
    precise float rising, falling;
    t = t < 0.0 ? t + 1.0 : t;
    t = t > 1.0 ? t - 1.0 : t;
    rising = p + t * ((q - p) * 6.0);
    falling = p + (2.0 / 3.0 - t) * (q - p) * 6.0;
    return t < 1.0 / 6.0 ? rising : t < 0.5 ? q : t < 2.0 / 3.0 ? falling : p;
}
vec3 grade(vec3 c, FloatBuf settings) {
    precise vec3 rgb = c;
    for (uint i = 0u; i < 3u; ++i) {
        precise float v = unit(unit(rgb[i]) * settings.v[6]);
        rgb[i] = unit(v + settings.v[7] * (v * v * (3.0 - (v + v)) - v));
    }
    precise float hi = max(max(rgb.r, rgb.g), rgb.b);
    precise float lo = min(min(rgb.r, rgb.g), rgb.b);
    precise float light = (hi + lo) * 0.5;
    precise float delta = hi - lo;
    bool grey = !(hi > lo);
    float spread = grey ? 1.0 : delta;
    precise float bright = (2.0 - hi) - lo, dark = hi + lo;
    precise float chroma = light > 0.5 ? divide(delta, grey ? 1.0 : bright)
                                     : divide(delta, grey ? 1.0 : dark);
    /* Keep the divisor runtime-visible: Intel's constant-divisor folding can
     * replace the corrected divide by a reciprocal multiplication. */
    precise float hr = divide(divide(rgb.g - rgb.b, spread) + (rgb.g < rgb.b ? 6.0 : 0.0), settings.v[11]);
    precise float hg = divide(divide(rgb.b - rgb.r, spread) + 2.0, settings.v[11]);
    precise float hb = divide(divide(rgb.r - rgb.g, spread) + 4.0, settings.v[11]);
    float hue = grey ? 0.0 : hi == rgb.r ? hr : hi == rgb.g ? hg : hb;
    chroma = unit((grey ? 0.0 : chroma) * settings.v[8]);
    precise float q = light < 0.5 ? light * (chroma + 1.0) : (light + chroma) - light * chroma;
    precise float p = (light + light) - q;
    if (chroma <= 0.0) return vec3(unit(light));
    return vec3(unit(hue_channel(p, q, hue + 1.0 / 3.0)),
                unit(hue_channel(p, q, hue)),
                unit(hue_channel(p, q, hue - 1.0 / 3.0)));
}
void axis(uint dest, uint src_extent, uint dest_extent, float ratio,
          out uint lo, out uint hi, out float weight) {
    if (src_extent == dest_extent) { lo = dest; hi = dest; weight = 0.0; return; }
    precise float centre = (float(dest) + 0.5) * ratio - 0.5;
    lo = uint(clamp(floor(centre), 0.0, float(src_extent - 1u)));
    hi = min(lo + 1u, src_extent - 1u);
    weight = clamp(centre - float(lo), 0.0, 1.0);
}
void main() {
    /* The linear pixel this invocation owns, from a TWO-dimensional workgroup grid: see the same
     * form in image_preprocess.comp, which explains why one dimension is not enough. A dispatch
     * that fits in one dimension is unchanged, because the y row is then always zero. */
    uint index = (gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x) * gl_WorkGroupSize.x
               + gl_LocalInvocationID.x;
    if ((pc.p[10] & (1024u | 2048u)) != 0u) { detail(index, pc.p[10]); return; }
    uint frame_width = pc.p[0], frame_height = pc.p[1];
    if (index >= frame_width * frame_height) return;
    uint x = index % frame_width, y = index / frame_width;
    uint raw = UintBuf(pc.a).v[index];
    UintBuf output_pixels = UintBuf(pc.e);
    uint left = pc.p[2], top = pc.p[3], width = pc.p[4], height = pc.p[5];
    if (x < left || x >= left + width || y < top || y >= top + height) {
        output_pixels.v[index] = raw;
        return;
    }
    x -= left; y -= top;
    uint pixel = y * width + x, flags = pc.p[10];
    FloatBuf settings = FloatBuf(pc.h);
    bool bgra = (flags & 1u) != 0u;
    /* A hardware reciprocal of 255 differs by one ULP on Intel. Input colour
     * must use the CPU's exact float32 values, especially near FP16 ties. */
    precise vec3 rgb = vec3(settings.v[16u + ((raw >> (bgra ? 16u : 0u)) & 255u)],
                           settings.v[16u + ((raw >> 8u) & 255u)],
                           settings.v[16u + ((raw >> (bgra ? 0u : 16u)) & 255u)]);
    uint xlo, xhi, ylo, yhi; float wx, wy;
    axis(x, pc.p[6], width, settings.v[9], xlo, xhi, wx);
    axis(y, pc.p[7], height, settings.v[10], ylo, yhi, wy);
    FloatBuf head = FloatBuf(pc.b);
    uint channels = pc.p[9], row = pc.p[8] * channels;
    precise vec4 h;
    for (uint c = 0u; c < 4u; ++c) {
        /* Resampling is rows then columns with an FP32 rounding after each
         * axis, as nr_daemon.resample and native nr_compose_encode. */
        precise float a = head.v[ylo * row + xlo * channels + c];
        precise float b = head.v[ylo * row + xhi * channels + c];
        if (pc.p[7] != height) {
            a = a * (1.0 - wy) + head.v[yhi * row + xlo * channels + c] * wy;
            b = b * (1.0 - wy) + head.v[yhi * row + xhi * channels + c] * wy;
        }
        h[c] = pc.p[6] == width ? a : a * (1.0 - wx) + b * wx;
    }
    precise vec3 predicted;
    for (uint c = 0u; c < 3u; ++c) predicted[c] = unit(rgb[c] + half_round(h[c]) * 0.25);
    bool temporal = (flags & 2u) != 0u;
    if (temporal) {
        /* packHalf is only asked to encode an already-exact FP16 value. The
         * rounding is float16_t, matching the runtime's tested half path. */
        uint bits = packHalf2x16(vec2(half_round(h.w), 0.0)) & 65535u;
        precise float alpha = settings.v[272u + bits] * settings.v[1];
        /* The game's last frame here and the history this pixel blends towards. */
        vec3 earlier = vec3(0.0), held;
        if ((flags & 64u) != 0u) {
            /* MOVED: the follower's active-extent pass, here (image_history.comp, mode 0). The
             * game's last frame and the network's last output read where this pixel's surface
             * was, NOTHING and the frame itself where the motion is not known, and the frame
             * itself for the history where that surface was another. `rgb` holds the frame's
             * float32 values exactly as the decode pass that pass read does. */
            float u, v;
            bool known = moved_to(FloatBuf(uint64_t(pc.p[12]) | (uint64_t(pc.p[13]) << 32u)),
                                  frame_width, left, top, x, y, x, y, width, height, width, height,
                                  u, v);
            earlier = known ? history_sample(FloatBuf(pc.d), height, width, u, v) : vec3(-1.0);
            held = known ? history_sample(FloatBuf(pc.c), height, width, u, v) : vec3(rgb);
            if (apart(vec3(rgb), earlier) > uintBitsToFloat(pc.p[11])) held = vec3(rgb);
        } else {
            FloatBuf history = FloatBuf(pc.c);
            held = vec3(history.v[3u * pixel], history.v[3u * pixel + 1u], history.v[3u * pixel + 2u]);
            if ((flags & 512u) != 0u) {
                uint before = UintBuf(pc.d).v[index];
                earlier = vec3(settings.v[16u + ((before >> (bgra ? 16u : 0u)) & 255u)],
                               settings.v[16u + ((before >> 8u) & 255u)],
                               settings.v[16u + ((before >> (bgra ? 0u : 16u)) & 255u)]);
            } else if ((flags & 4u) != 0u) {
                FloatBuf previous = FloatBuf(pc.d);
                earlier = vec3(previous.v[3u * pixel], previous.v[3u * pixel + 1u], previous.v[3u * pixel + 2u]);
            }
        }
        if ((flags & 4u) != 0u) {
            precise vec3 step = abs(rgb - earlier);
            float moved = max(max(step.r, step.g), step.b);
            if (settings.v[5] != 0.0) alpha *= unit(moved * settings.v[5] + 1.0);
            precise float floor_value = moved * settings.v[4] + settings.v[3];
            floor_value = min(min(max(floor_value, 0.0), settings.v[3]), 1.0);
            floor_value *= settings.v[2];
            alpha = max(alpha, floor_value);
        }
        for (uint c = 0u; c < 3u; ++c)
            predicted[c] += alpha * (held[c] - predicted[c]);
    }
    if ((flags & (8u | 16u)) != 0u) {
        vec3 kept;
        for (uint c = 0u; c < 3u; ++c) kept[c] = trunc_half(predicted[c]);
        if ((flags & 8u) != 0u) {
            FloatBuf neural = FloatBuf(pc.f);
            for (uint c = 0u; c < 3u; ++c) neural.v[3u * pixel + c] = kept[c];
        }
        if ((flags & 16u) != 0u) predicted = grade(kept, settings);
    }
    float intensity = settings.v[0];
    float blend = temporal || intensity > 1.0 ? intensity : unit(intensity);
    FloatBuf composition = FloatBuf(pc.g);
    uint packed = raw & 0xff000000u;
    for (uint c = 0u; c < 3u; ++c) {
        precise float v = unit(rgb[c] + blend * (predicted[c] - rgb[c]));
        if ((flags & 4096u) != 0u) {
            precise float moved = v - rgb[c];
            composition.v[3u * pixel + c] = moved;
        } else if ((flags & 32u) != 0u) composition.v[3u * pixel + c] = v;
        float safe = isnan(v) ? 0.0 : unit(v);
        uint byte_value = uint(safe * 255.0 + 0.5);
        packed |= byte_value << ((bgra ? 2u - c : c) * 8u);
    }
    output_pixels.v[index] = packed;
}
