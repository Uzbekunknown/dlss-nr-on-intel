; NR's amd_fidelityfx_dx12.dll (nr_ffx.c): the FidelityFX API's five exports, the names AMD's
; amd_fidelityfx_dx12.dll and amd_fidelityfx_loader_dx12.dll export, and OptiPluginInit, which
; OptiScaler v10 calls on a custom upscaler's DLL and this one hands on to the upscaler's own.
LIBRARY amd_fidelityfx_dx12
EXPORTS
    ffxConfigure
    ffxCreateContext
    ffxDestroyContext
    ffxDispatch
    ffxQuery
    OptiPluginInit
